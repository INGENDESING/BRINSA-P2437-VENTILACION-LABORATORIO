# Archivos temporales de LaTeX
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
env/
.venv/

# Sistema Operativo
.DS_Store
Thumbs.db

# Ignorar otras carpetas temporales o de caché
.vscode/
.idea/

# Intermedios LaTeX generados por scripts de conversión en build/lis/
build/lis/*.tex

# Config local de Obsidian (las notas del vault SÍ se versionan)
# El vault de Obsidian es la raíz del proyecto; vault/ es el subsistema de memoria
/.obsidian/
vault/.obsidian/
