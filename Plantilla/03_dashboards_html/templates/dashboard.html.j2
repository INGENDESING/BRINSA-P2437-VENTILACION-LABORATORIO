<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{ titulo }} — {{ proyecto_codigo }}</title>
    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
    <style>
        :root { --dml-verde: #2e7d32; --dml-gris: #424242; }
        body { font-family: "TeX Gyre Termes", Georgia, serif; margin: 0; background: #fafafa; color: #222; }
        header { background: var(--dml-verde); color: white; padding: 1rem 2rem; }
        header h1 { margin: 0; font-size: 1.4rem; font-weight: 500; }
        header .meta { opacity: 0.85; font-size: 0.9rem; }
        main { max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem; }
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .kpi { background: white; padding: 1rem 1.2rem; border-left: 4px solid var(--dml-verde); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        .kpi .v { font-size: 1.6rem; font-weight: 600; color: var(--dml-gris); }
        .kpi .l { font-size: 0.85rem; text-transform: uppercase; letter-spacing: .05em; color: #777; }
        .plot { background: white; padding: 1rem; margin-bottom: 1.5rem; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        footer { text-align: center; padding: 2rem; color: #777; font-size: 0.85rem; }
    </style>
</head>
<body>
<header>
    <h1>{{ titulo }}</h1>
    <div class="meta">{{ proyecto_codigo }} · {{ cliente }} · Rev. {{ revision }} · {{ fecha }}</div>
</header>
<main>
    <section class="kpi-grid">
        {% for k in kpis %}
        <div class="kpi"><div class="l">{{ k.label }}</div><div class="v">{{ k.valor }}</div></div>
        {% endfor %}
    </section>
    {% for fig in figuras %}
    <div class="plot" id="plot-{{ loop.index }}"></div>
    <script>Plotly.newPlot('plot-{{ loop.index }}', {{ fig.data|safe }}, {{ fig.layout|safe }}, {responsive: true});</script>
    {% endfor %}
</main>
<footer>DML Ingeniería · Generado automáticamente — no editar manualmente.</footer>
</body>
</html>
